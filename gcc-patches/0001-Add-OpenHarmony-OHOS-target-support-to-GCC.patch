+
+/* Define architecture-specific dynamic linker with float ABI support.
+   Use spec string to select at link time based on -mfloat-abi option. */
+#define OHOS_DYNAMIC_LINKER_SOFT "/lib/ld-musl-arm.so.1"
+#define OHOS_DYNAMIC_LINKER_HARD "/lib/ld-musl-armhf.so.1"
+#define OHOS_ARCH_DYNAMIC_LINKER \
