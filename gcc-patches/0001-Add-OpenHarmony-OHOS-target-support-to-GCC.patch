+#ifndef GCC_MIPS_OHOS_H
+#define GCC_MIPS_OHOS_H
+
+/* Define architecture-specific dynamic linker - use spec strings for runtime selection.
+   Match LLVM getDynamicLinker() and musl conventions. */
+#define OHOS_DYNAMIC_LINKER32 \
+  "/lib/ld-musl-mips%{mips32r6|mips64r6:r6}%{EL:el}%{msoft-float:-sf}.so.1"
+#define OHOS_DYNAMIC_LINKER64 \
+  "/lib/ld-musl-mips64%{mips64r6:r6}%{EL:el}%{msoft-float:-sf}.so.1"
+#define OHOS_DYNAMIC_LINKERN32 \
+  "/lib/ld-musl-mipsn32%{mips64r6:r6}%{EL:el}%{msoft-float:-sf}.so.1"
+
+/* Select appropriate linker based on ABI - use same pattern as gnu-user.h */
+#define OHOS_ARCH_DYNAMIC_LINKER32 OHOS_DYNAMIC_LINKER32
+#define OHOS_ARCH_DYNAMIC_LINKER64 OHOS_DYNAMIC_LINKER64
+#define OHOS_ARCH_DYNAMIC_LINKERN32 OHOS_DYNAMIC_LINKERN32
+
+/* Include the generic OpenHarmony configuration */
+/* Note: ohos.h is already included via tm.h, no need to include again */
+
+/* MIPS-specific OpenHarmony defines - override Linux configuration */
+#ifdef TARGET_OS_CPP_BUILTINS
+#undef TARGET_OS_CPP_BUILTINS
+#endif
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      /* Include base GNU and OHOS defines */ \
+      GNU_USER_TARGET_OS_CPP_BUILTINS ();	\
+      OHOS_BASE_OS_CPP_BUILTINS ();		\
+      /* MIPS-specific defines */ \
+      builtin_define ("__mips__");		\
+      builtin_assert ("cpu=mips");		\
+      builtin_assert ("machine=mips");		\
+    }						\
+  while (0)
+
+/* OpenHarmony library paths for MIPS - use consistent naming */
+#define OHOS_ARCH_LIB_DIR "mips-linux-ohos"
+
+/* Inject architecture-specific include directories via the CPP spec. */
+#define OHOS_MULTIARCH_CPP_SPEC OHOS_MULTIARCH_INCLUDE_SPEC(OHOS_ARCH_LIB_DIR)
+#ifndef SUBTARGET_CPP_SPEC
+#define SUBTARGET_CPP_SPEC ""
+#endif
+#define OHOS_PREV_SUBTARGET_CPP_SPEC SUBTARGET_CPP_SPEC
+#undef SUBTARGET_CPP_SPEC
+#define SUBTARGET_CPP_SPEC OHOS_PREV_SUBTARGET_CPP_SPEC OHOS_MULTIARCH_CPP_SPEC
+#undef OHOS_PREV_SUBTARGET_CPP_SPEC
+#undef OHOS_MULTIARCH_CPP_SPEC
+
+/* Enhanced library search paths for OpenHarmony */
+#undef STANDARD_STARTFILE_PREFIX_1
+#define STANDARD_STARTFILE_PREFIX_1 "/usr/lib/"
+
+#undef STANDARD_STARTFILE_PREFIX_2
+#define STANDARD_STARTFILE_PREFIX_2 "/lib/"
+
+/* Library directories for OHOS - use flat structure without arch subdirs */
+#undef MD_EXEC_PREFIX
+#define MD_EXEC_PREFIX "/usr/lib/"
+
+#undef MD_STARTFILE_PREFIX
+#define MD_STARTFILE_PREFIX "/usr/lib/"
+
+#undef MD_STARTFILE_PREFIX_1
+#define MD_STARTFILE_PREFIX_1 "/lib/"
+
+/* Override STARTFILE and ENDFILE specs - OHOS uses flat /usr/lib/ structure */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{!shared: \
+     %{pg|p|profile:%R/usr/lib/crt1.o%s; \
+       pie:%R/usr/lib/Scrt1.o%s; \
+       :%R/usr/lib/crt1.o%s}} \
+   %R/usr/lib/crti.o%s \
+   %{static:crtbeginT.o%s;shared|pie:crtbeginS.o%s;:crtbegin.o%s}"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC \
+  "%{shared|pie:crtendS.o%s;:crtend.o%s} \
+   %R/usr/lib/crtn.o%s"
+
+/* Linker emulation modes - same as linux.h */
+#define OHOS_LINK_EMULATION32 "elf32%{EB:b}%{EL:l}tsmip"
+#define OHOS_LINK_EMULATION64 "elf64%{EB:b}%{EL:l}tsmip"
+#define OHOS_LINK_EMULATIONN32 "elf32%{EB:b}%{EL:l}tsmipn32"
+
+/* Define the link spec for MIPS OpenHarmony - follow gnu-user.h pattern */
+#undef LINK_SPEC
+#define LINK_SPEC						\
+  "%{G*} %{EB} %{EL} %{mips*} %{shared} "			\
+  "%{!shared: "							\
+    "%{!static: "						\
+      "%{rdynamic:-export-dynamic} "				\
+      "%{mabi=n32: -dynamic-linker " OHOS_ARCH_DYNAMIC_LINKERN32 "} "	\
+      "%{mabi=64: -dynamic-linker " OHOS_ARCH_DYNAMIC_LINKER64 "} "	\
+      "%{mabi=32: -dynamic-linker " OHOS_ARCH_DYNAMIC_LINKER32 "}} "	\
+    "%{static:-static}} "					\
+  "%{mabi=n32:-m " OHOS_LINK_EMULATIONN32 "} "			\
+  "%{mabi=64:-m " OHOS_LINK_EMULATION64 "} "			\
+  "%{mabi=32:-m " OHOS_LINK_EMULATION32 "} "			\
+  "-L%R/usr/lib " 						\
+  "-L%R/lib "
+
+/* Default to little endian and async unwind tables */
+#undef TARGET_DEFAULT_ASYNC_UNWIND_TABLES
+#define TARGET_DEFAULT_ASYNC_UNWIND_TABLES 1
+
+#endif /* GCC_MIPS_OHOS_H */
